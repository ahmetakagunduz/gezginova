generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id                 String   @id @default(uuid())
  userId             String
  countryId          String
  countryName        String
  departureCity      String
  days               Int
  budgetLevel        String
  visaPreference     String
  totalCost          Float
  flightCost         Float
  accommodationCost  Float
  dailyCost          Float
  visaCost           Float
  createdAt          DateTime @default(now())
  
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([countryId])
}
